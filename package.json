{
  "name": "backend-journey",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:phase-01": "pnpm --filter @backend-journey/phase-01-cli-todo dev",
    "cli:phase-01": "pnpm --filter @backend-journey/phase-01-cli-todo cli",
    "dev:phase-02": "pnpm --filter @backend-journey/phase-02-taskboard-api dev",
    "dev:phase-03": "pnpm --filter @backend-journey/phase-03-notes-api dev",
    "db:migrate:phase-03": "pnpm --filter @backend-journey/phase-03-notes-api db:migrate",
    "db:seed:phase-03": "pnpm --filter @backend-journey/phase-03-notes-api db:seed",
    "dev:phase-04-api": "pnpm --filter @backend-journey/phase-04-secure-notes-api dev",
    "dev:phase-04-web": "pnpm --filter @backend-journey/phase-04-secure-notes-web dev",
    "db:migrate:phase-04": "pnpm --filter @backend-journey/phase-04-secure-notes-api db:migrate",
    "db:seed:phase-04": "pnpm --filter @backend-journey/phase-04-secure-notes-api db:seed",
    "dev:phase-05-api": "pnpm --filter @backend-journey/phase-05-cached-feed-api dev",
    "dev:phase-05-web": "pnpm --filter @backend-journey/phase-05-cached-feed-web dev",
    "db:migrate:phase-05": "pnpm --filter @backend-journey/phase-05-cached-feed-api db:migrate",
    "db:seed:phase-05": "pnpm --filter @backend-journey/phase-05-cached-feed-api db:seed",
    "test:phase-05": "pnpm --filter @backend-journey/phase-05-cached-feed-api test",
    "docker:feed:build": "docker build -f apps/phase-05-cached-feed-api/Dockerfile -t cached-feed-api:local .",
    "docker:feed:up": "docker compose --profile feed up -d --build",
    "docker:feed:down": "docker compose --profile feed down",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint --if-present",
    "test": "pnpm -r run test --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
